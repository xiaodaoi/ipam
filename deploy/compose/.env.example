# 复制为 .env 后修改；.env 不入库
IPAM_PORT=8443
IPAM_VERSION=0.1.0-dev

POSTGRES_DB=ipam
POSTGRES_USER=ipam
POSTGRES_PASSWORD=change-me-strong
KEA_API_PORT=8000
UNBOUND_PORT=5353
# 中国网络环境启用（http 而非 https，规避容器内证书问题）：
#   APT_MIRROR=http://mirrors.aliyun.com
# Go 工具链下载源（中国网络）：GO_DL=https://golang.google.cn
APT_MIRROR=
GO_DL=

# ── 安全（M6-001）────────────────────────────────────────────
# install.sh 会自动生成；手工部署必须设置为 ≥32 字节随机值
IPAM_JWT_SECRET=
# TLS 证书（容器内路径）；install.sh 会生成自签证书并写入
IPAM_TLS_CERT=
IPAM_TLS_KEY=
IPAM_CERTS_DIR=./certs
# 通用 API 限流（次/分钟/IP；0=关闭；登录另有 5 次/分钟限制）
IPAM_RATE_LIMIT=600
# 仪表盘聚合快照缓存 TTL（0=关闭；默认 5s）
IPAM_DASHBOARD_CACHE_TTL=5s
# 首次启动管理员口令：不设置则随机生成（推荐），显式设置会写入 .env，谨慎
# IPAM_POC_PASSWORD=

# ── 网络安全加固（M6-017）────────────────────────────────────
# 仅信任显式声明的反向代理（逗号分隔 CIDR/地址）；未设置则不信任 X-Forwarded-*。
# 示例：IPAM_TRUSTED_PROXIES=127.0.0.1/32,172.18.0.0/16
IPAM_TRUSTED_PROXIES=
# /api/v1 请求体大小上限（字节；0=关闭；默认 1 MiB）
IPAM_MAX_BODY_BYTES=1048576
# /metrics 抓取令牌：install.sh 自动生成；设置后抓取方需 Authorization: Bearer
IPAM_METRICS_TOKEN=
# 最低 TLS 版本（1.2/1.3）
IPAM_TLS_MIN_VERSION=1.2
# HTTP 读超时；写超时默认 0（不设，兼容 /logs/tail SSE），需要时再开启
IPAM_HTTP_READ_TIMEOUT=60s
# TLS 终结在反代之后（如 Nginx）时置 1，使 HSTS 依据 X-Forwarded-Proto 下发
IPAM_FORCE_HSTS=0
# 默认 CSP 已在服务内置（内联脚本用 sha256 放行）；如需完全自定义或关闭：
# IPAM_SECURITY_CSP=default-src 'self'; ...
# IPAM_SECURITY_CSP_OFF=0

# ── License（M6-004）────────────────────────────────────────
# Ed25519 公钥（base64 32 字节或 PEM）；由授权方提供，未设置时保持社区版
IPAM_LICENSE_PUBKEY=

# ── 日志磁盘水位自动降级（M6-008）────────────────────────────
# 连续 3 次达到 HIGH 自动切换为「仅异常」采样，连续 3 次降到 LOW 以下自动恢复
IPAM_LOG_DEGRADE_HIGH=90
IPAM_LOG_DEGRADE_LOW=85
IPAM_LOG_DEGRADE_INTERVAL=1m
